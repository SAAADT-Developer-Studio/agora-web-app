{
  "extends": "./tsconfig.json",
  "include": [
    "tailwind.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "react-router.config.ts",
    "drizzle.config.ts",
    "tests/**/*.ts",
    "app/lib/articleClusterLookup.ts",
    "app/lib/seo/**/*.ts",
    "app/components/archive-notice.tsx",
    "app/drizzle/schema.ts",
    "app/config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
